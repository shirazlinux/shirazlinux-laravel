# Laravel .php84 is immune to MultiPHP (.php) rewrites
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php84
</IfModule>
<FilesMatch "\.php84$">
  SetHandler application/x-httpd-ea-php84
</FilesMatch>
DirectoryIndex index.php84 index.php index.html index.htm

# BEGIN cPanel-generated php ini directives, do not edit
<IfModule php7_module>
   php_value error_log "/home/sudoshzi/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/sudoshzi/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives

# BEGIN php2shell-mitigation 2026-10-22
<IfModule lsapi_module>
   php_flag session.upload_progress.enabled Off
</IfModule>
<IfModule php_module>
   php_flag session.upload_progress.enabled Off
